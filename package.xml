<?xml version="1.0"?>
<package format="3">
  <name>direct_joy</name>
  <version>0.1.0</version>
  <description>Standalone adaptation of the I2R direct joystick velocity controller.</description>
  <maintainer email="yuda@example.com">yuda</maintainer>
  <license>BSD</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_srvs</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>joy</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_test</test_depend>
  <test_depend>rclpy</test_depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
